#usda 1.0
(
    customLayerData = {
        double cup_contact_damping_N_s_per_m = 40
        double cup_contact_stiffness_N_per_m = 40000
        double cup_dynamic_friction = 0.4
        double cup_static_friction = 0.5
        double left_finger_dynamic_friction = 0.5
        double left_finger_static_friction = 0.65
        double right_finger_dynamic_friction = 0.5
        double right_finger_static_friction = 0.65
        string status = "Unmeasured rigid-cup contact spring/friction trial, not deformable PVC"
    }
    subLayers = [
        @dual_franka_yubi_stiff_contact_trial.usda@
    ]
)

over "World"
{
    over "ContactExperiment"
    {
        over "CompliantCupPlastic"
        {
            float physics:dynamicFriction = 0.4
            float physics:staticFriction = 0.5
            float physxMaterial:compliantContactStiffness = 40000
        }
    }
}
