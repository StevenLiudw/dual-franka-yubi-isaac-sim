#usda 1.0
(
    customLayerData = {
        double contact_offset_m = 0.001
        double distal_cutoff_m = 0.07
        string status = "Unmeasured textured hard-plastic distal contact approximation; rigid bodies, no rubber or elastic deformation"
    }
    subLayers = [
        @dual_franka_yubi_replay.usda@
    ]
)

over "World"
{
    def "ContactExperiment"
    {
        def Material "Plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "TexturedPlastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.65
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "FingerBody" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }

    over "Objects"
    {
        over "Tray"
        {
            over "Collision"
            {
                over "Base" (
                    prepend apiSchemas = ["MaterialBindingAPI", "PhysxCollisionAPI"]
                )
                {
                    rel material:binding:physics = </World/ContactExperiment/Plastic> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                    float physxCollision:contactOffset = 0.001
                    float physxCollision:restOffset = 0
                }

                over "Wall_00" (
                    prepend apiSchemas = ["MaterialBindingAPI", "PhysxCollisionAPI"]
