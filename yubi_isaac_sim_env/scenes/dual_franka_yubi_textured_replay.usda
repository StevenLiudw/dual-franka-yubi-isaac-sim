    over "Robots"
    {
        over "LeftMount"
        {
            over "Panda"
            {
                over "yubi_leftfinger"
                {
                    over "geometry"
                    {
                        bool physics:collisionEnabled = 0
                    }

                    def Mesh "TexturedContact" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI", "PhysxCollisionAPI"]
