#usda 1.0
(
    customLayerData = {
        int cup_contact_colliders = 33
        double cup_contact_damping_N_s_per_m = 40
        double cup_contact_stiffness_N_per_m = 20000
        string status = "Unmeasured compliant cup contact; original 80 mm visual and collision geometry remain rigid and unchanged"
    }
    subLayers = [
        @dual_franka_yubi_textured_replay.usda@
    ]
)

over "World"
{
    over "ContactExperiment"
    {
        def Material "CompliantCupPlastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
            bool physxMaterial:compliantContactAccelerationSpring = 0
            float physxMaterial:compliantContactDamping = 40
            float physxMaterial:compliantContactStiffness = 20000
            uniform token physxMaterial:frictionCombineMode = "average"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }

    over "Objects"
    {
        over "Cup"
        {
            over "Collision"
            {
                over "Base" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </World/ContactExperiment/CompliantCupPlastic> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }

                over "Wall_00" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </World/ContactExperiment/CompliantCupPlastic> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }

